// Prisma Schema - 文旅 GEO 服务平台 (SQLite版本)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────────────────────
// 文旅资源（核心实体）
// ──────────────────────────────────────────────────────────────

model TourismResource {
  id          String   @id @default(uuid())
  phone       String   @unique
  name        String
  avatar      String?
  description String?
  
  city        String
  district    String?
  scenicArea  String?
  
  resourceType String   // SCENIC_SPOT, HOTEL, CREATIVE_SHOP, PLAY_ITEM, SECOND_CONSUME
  
  isVerified      Boolean @default(false)
  realName        String?
  
  avgRating       Float   @default(0)
  reviewCount     Int     @default(0)
  
  status      String @default("ACTIVE") // ACTIVE, INACTIVE, BANNED
  
  categoryId  String
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  geoLocation       GeoLocation?
  category          ResourceCategory @relation(fields: [categoryId], references: [id])
  articles          ContentArticle[]
  certificates      Certificate[]
  reviews           Review[]
  platformAccounts  PlatformAccount[]
  distributionLinks DistributionLink[]
  resourceMedia     ResourceMedia[]

  @@map("tourism_resources")
}

// ──────────────────────────────────────────────────────────────
// 地理位置
// ──────────────────────────────────────────────────────────────

model GeoLocation {
  id            String  @id @default(uuid())
  resourceId    String  @unique
  resource      TourismResource @relation(fields: [resourceId], references: [id])

  latitude      Float
  longitude     Float
  fullAddress   String

  serviceRadiusKm Int @default(5)
  geoHash       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([geoHash])
  @@map("geo_locations")
}

// ──────────────────────────────────────────────────────────────
// 文旅资源分类
// ──────────────────────────────────────────────────────────────

model ResourceCategory {
  id         String  @id @default(uuid())
  name       String
  parentId   String?
  level      Int
  iconKey    String?
  resourceType String

  resources  TourismResource[]

  @@map("resource_categories")
}

// ──────────────────────────────────────────────────────────────
// 分销链接
// ──────────────────────────────────────────────────────────────

model DistributionLink {
  id            String   @id @default(uuid())
  resourceId    String
  resource      TourismResource @relation(fields: [resourceId], references: [id])

  linkType      String   // DIRECT_LINK, DISTRIBUTION
  linkUrl       String
  platform      String?
  
  commissionRate Float?
  
  isActive      Boolean @default(true)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  commissionRecords CommissionRecord[]

  @@map("distribution_links")
}

// ──────────────────────────────────────────────────────────────
// 佣金记录
// ──────────────────────────────────────────────────────────────

model CommissionRecord {
  id            String   @id @default(uuid())
  linkId        String
  link          DistributionLink @relation(fields: [linkId], references: [id])

  orderId       String?
  orderAmount   Float
  commissionAmount Float
  
  transactionAt DateTime @default(now())
  status        String @default("PENDING") // PENDING, CONFIRMED, SETTLED, CANCELLED
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("commission_records")
}

// ──────────────────────────────────────────────────────────────
// AI 生成的宣传内容
// ──────────────────────────────────────────────────────────────

model ContentArticle {
  id           String   @id @default(uuid())
  resourceId   String
  resource     TourismResource @relation(fields: [resourceId], references: [id])

  targetPlatform String
  title         String
  content       String

  seoKeywords  String  // JSON字符串
  geoKeywords  String  // JSON字符串

  schemaOrgType String @default("TouristAttraction")

  status       String @default("DRAFT") // DRAFT, APPROVED, DISTRIBUTING, PUBLISHED, FAILED

  generatedAt  DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  distributions DistributionRecord[]

  @@map("content_articles")
}

// ──────────────────────────────────────────────────────────────
// 分发记录
// ──────────────────────────────────────────────────────────────

model DistributionRecord {
  id          String   @id @default(uuid())
  articleId   String
  article     ContentArticle @relation(fields: [articleId], references: [id])

  platform    String

  externalUrl String?
  status      String @default("PENDING") // PENDING, SUCCESS, FAILED, UNDER_REVIEW

  viewCount  Int @default(0)
  isIndexed  Boolean @default(false)
  indexedAt  DateTime?
  errorMsg   String?

  distributedAt DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("distribution_records")
}

// ──────────────────────────────────────────────────────────────
// 平台账号绑定
// ──────────────────────────────────────────────────────────────

model PlatformAccount {
  id          String   @id @default(uuid())
  resourceId  String
  resource    TourismResource @relation(fields: [resourceId], references: [id])

  platform    String
  openId      String?
  accessToken String?
  refreshToken String?
  expiresAt   DateTime?
  status      String @default("PENDING") // PENDING, ACTIVE, EXPIRED, REVOKED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([resourceId, platform])
  @@map("platform_accounts")
}

// ──────────────────────────────────────────────────────────────
// 文旅资源媒体文件
// ──────────────────────────────────────────────────────────────

model ResourceMedia {
  id          String   @id @default(uuid())
  resourceId  String
  resource    TourismResource @relation(fields: [resourceId], references: [id])

  mediaType   String   // IMAGE, VIDEO
  url         String
  thumbnailUrl String?
  fileName    String
  fileSize    Int
  
  width       Int?
  height      Int?
  duration    Int?
  
  title       String?
  sortOrder   Int @default(0)
  isPrimary   Boolean @default(false)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("resource_media")
}

// ──────────────────────────────────────────────────────────────
// 资质证书
// ──────────────────────────────────────────────────────────────

model Certificate {
  id          String   @id @default(uuid())
  resourceId  String
  resource    TourismResource @relation(fields: [resourceId], references: [id])

  certType    String  // IDENTITY, BUSINESS_LICENSE, SCENIC_LICENSE, HOTEL_LICENSE, AWARD, OTHER
  imageUrl    String
  description String?

  status      String @default("PENDING") // PENDING, APPROVED, REJECTED
  verifiedAt  DateTime?
  verifiedBy  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("certificates")
}

// ──────────────────────────────────────────────────────────────
// 评价
// ──────────────────────────────────────────────────────────────

model Review {
  id           String   @id @default(uuid())
  resourceId   String
  resource     TourismResource @relation(fields: [resourceId], references: [id])

  reviewerName String?
  rating       Float
  comment      String?
  imageUrls    String  // JSON字符串

  isVerified   Boolean @default(false)
  verifyToken  String? @unique

  createdAt DateTime @default(now())

  @@map("reviews")
}

// ──────────────────────────────────────────────────────────────
// 短信验证码
// ──────────────────────────────────────────────────────────────

model SmsCode {
  id        String   @id @default(uuid())
  phone     String
  code      String
  purpose   String
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone, purpose])
  @@map("sms_codes")
}

// ──────────────────────────────────────────────────────────────
// 分发渠道配置
// ──────────────────────────────────────────────────────────────

model PlatformChannel {
  id            String  @id @default(uuid())
  platform      String @unique
  displayName   String
  iconUrl       String?
  isLlmFriendly Boolean @default(false)
  authType      String
  config        String? // JSON字符串

  @@map("platform_channels")
}

// ──────────────────────────────────────────────────────────────
// 文旅行业管理人员
// ──────────────────────────────────────────────────────────────

model IndustryAdmin {
  id          String   @id @default(uuid())
  phone       String   @unique
  name        String
  role        String   // REGION_ADMIN, SCENIC_ADMIN, PLATFORM_ADMIN
  region      String
  isVerified  Boolean @default(false)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("industry_admins")
}

// ──────────────────────────────────────────────────────────────
// 策展方案（核心实体）
// ──────────────────────────────────────────────────────────────

model ExhibitionPlan {
  id          String   @id @default(uuid())
  phone       String   // 关联用户手机号

  // 步骤1: 基本信息
  basicInfo   ExhibitionBasicInfo?
  
  // 步骤2: 展览定位
  positioning ExhibitionPositioning?
  
  // 步骤3: 展区规划
  zones       ExhibitionZone[]
  
  // 步骤4: 核心展品配置
  coreExhibits ExhibitionCoreExhibit[]
  
  // 步骤5: 辅助展品清单
  auxiliaryExhibits ExhibitionAuxiliaryExhibit[]
  
  // 步骤6: 展陈设计
  displayDesign ExhibitionDisplayDesign?
  
  // 步骤7: 教育推广
  educationPlan ExhibitionEducation?
  
  // 生成的方案内容
  generatedContent String?  // JSON格式的完整策展方案
  
  status      String @default("DRAFT") // DRAFT, GENERATING, COMPLETED, FAILED
  version     Int @default(1)
  parentId    String?  // 用于版本控制，指向父版本ID
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  generatedAt DateTime?
  
  parent      ExhibitionPlan? @relation("ExhibitionPlanVersions", fields: [parentId], references: [id])
  versions    ExhibitionPlan[] @relation("ExhibitionPlanVersions")

  @@map("exhibition_plans")
}

// 展览基本信息
model ExhibitionBasicInfo {
  id            String @id @default(uuid())
  planId        String @unique
  plan          ExhibitionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  
  theme         String  // 展览主题，如"水利文明"、"丝绸之路"
  name          String  // 展览名称
  organizer     String? // 主办单位
  venue         String? // 展览地点
  startDate     String? // 开始时间
  endDate       String? // 结束时间
  area          Int?    // 预计面积（平方米）
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("exhibition_basic_info")
}

// 展览定位
model ExhibitionPositioning {
  id            String @id @default(uuid())
  planId        String @unique
  plan          ExhibitionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  
  planType      String  // 常设展 / 临时展 / 专题展
  targetAudience String // 普通观众 / 专业观众 / 青少年 / 亲子家庭
  targetAudienceOther String? // 其他目标受众描述
  educationGoal String? // 教育目的描述
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("exhibition_positioning")
}

// 展区规划
model ExhibitionZone {
  id            String @id @default(uuid())
  planId        String
  plan          ExhibitionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  
  zoneNumber    Int    // 展区序号
  name          String // 展区名称
  subtitle      String? // 展区副标题
  timePeriod    String? // 对应时代/时期
  narrative     String? // 核心叙事
  exhibitCount  Int @default(0) // 展品数量
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("exhibition_zones")
}

// 核心展品（灵魂展品）
model ExhibitionCoreExhibit {
  id            String @id @default(uuid())
  planId        String
  plan          ExhibitionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  zoneId        String? // 所属展区ID
  
  exhibitName   String // 展品名称
  era           String? // 时代
  origin        String? // 出土地/来源
  material      String? // 材质
  artifactLevel String? // 文物等级：一级/二级/三级
  description   String? // 展品描述
  significance  String? // 重要性说明（为什么是灵魂展品）
  displayMethod String? // 展示方式建议
  positionDesign String? // 位置设计建议
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("exhibition_core_exhibits")
}

// 辅助展品
model ExhibitionAuxiliaryExhibit {
  id            String @id @default(uuid())
  planId        String
  plan          ExhibitionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  zoneId        String? // 所属展区ID
  
  exhibitName   String // 展品名称
  era           String? // 时代
  origin        String? // 出土地/来源
  material      String? // 材质
  artifactLevel String? // 文物等级
  description   String? // 展品描述
  isReplica     Boolean @default(false) // 是否为复制品
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("exhibition_auxiliary_exhibits")
}

// 展陈设计
model ExhibitionDisplayDesign {
  id            String @id @default(uuid())
  planId        String @unique
  plan          ExhibitionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  
  totalArea     Int?    // 总面积（平方米）
  layoutType    String? // 线性布局 / 环形布局 / 混合布局
  trafficDesign String? // 动线设计描述
  lightingDesign String? // 灯光设计描述
  multimediaConfig String? // 多媒体配置
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("exhibition_display_design")
}

// 教育推广计划
model ExhibitionEducation {
  id            String @id @default(uuid())
  planId        String @unique
  plan          ExhibitionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  
  activities    String? // 配套活动（如讲解、工作坊）
  educationPrograms String? // 社教项目
  publicityPlan  String? // 宣传方案
  publications   String? // 出版物
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("exhibition_education")
}